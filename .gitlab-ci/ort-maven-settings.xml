<settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/SETTINGS/1.0.0"
    xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
    <servers>
        <server>
            <id>google</id>
            <username>${env.GL_TECH_USER_NAME}</username>
            <password>${env.GL_ART_ID_TOKEN}</password>
        </server>
        <server>
            <id>maven-central</id>
            <username>${env.GL_TECH_USER_NAME}</username>
            <password>${env.GL_ART_ID_TOKEN}</password>
        </server>
        <server>
            <id>sekt-idp-final</id>
            <username>${env.GL_TECH_USER_NAME}</username>
            <password>${env.GL_ART_ID_TOKEN}</password>
        </server>
        <server>
            <id>sekt-idp-staging</id>
            <username>${env.GL_TECH_USER_NAME}</username>
            <password>${env.GL_ART_ID_TOKEN}</password>
        </server>
    </servers>
    <profiles>
        <profile>
            <id>default</id>
            <repositories>
                <repository>
                    <id>google</id>
                    <name>Google</name>
                    <url>https://partner.bdr.de/artifactory/maven-google/</url>
                </repository>
                <repository>
                    <id>maven-central</id>
                    <name>Maven Central</name>
                    <url>https://partner.bdr.de/artifactory/repo1/</url>
                </repository>
                <repository>
                    <id>gradle-plugin-portal</id>
                    <name>Gradle Plugin Portal</name>
                    <url>https://plugins.gradle.org/m2/</url>
                </repository>
                <repository>
                    <id>sekt-idp-final</id>
                    <name>Sektoraler IDP Repository</name>
                    <url>${env.ARTIFACTORY_URL}</url>
                </repository>
                <repository>
                    <id>sekt-idp-staging</id>
                    <name>Sektoraler IDP Repository Staging</name>
                    <url>${env.ARTIFACTORY_SNAPSHOT_URL}</url>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>
    <activeProfiles>
        <activeProfile>default</activeProfile>
    </activeProfiles>
</settings>
